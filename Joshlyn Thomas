C# Code
using System;
using System.Collections.Generic;
using System.Windows.Forms;

namespace CulturalFestivalApp
{
    public partial class MainForm : Form
    {
        private List<Participant> participants = new List<Participant>();

        public MainForm()
        {
            InitializeComponent();
        }

        private void btnRegister_Click(object sender, EventArgs e)
        {
            try
            {
                string name = txtName.Text.Trim();
                string category = cmbCategory.Text;
                decimal fee = decimal.Parse(txtFee.Text);

                if (string.IsNullOrEmpty(name) || string.IsNullOrEmpty(category))
                    throw new Exception("All fields must be filled.");

                Participant p = new Participant(name, category, txtContact.Text, fee);
                participants.Add(p);
                lblMessage.Text = "Participant registered successfully!";
                lblMessage.ForeColor = System.Drawing.Color.Green;
            }
            catch (Exception ex)
            {
                lblMessage.Text = ex.Message;
                lblMessage.ForeColor = System.Drawing.Color.Red;
            }
        }

        private void btnView_Click(object sender, EventArgs e)
        {
            lstParticipants.Items.Clear();
            foreach (var p in participants)
            {
                lstParticipants.Items.Add(p.ToString());
            }
        }
    }

    public class Participant
    {
        public string Name { get; set; }
        public string CategoryCode { get; set; }
        public string ContactInfo { get; set; }
        public decimal FeePaid { get; set; }

        public Participant(string name, string category, string contact, decimal fee)
        {
            if (fee < 0) throw new ArgumentException("Fee must be non-negative.");
            Name = name;
            CategoryCode = category;
            ContactInfo = contact;
            FeePaid = fee;
        }

        public override string ToString()
        {
            return $"{Name} - {CategoryCode} - Fee: ${FeePaid}";
        }
    }
}

